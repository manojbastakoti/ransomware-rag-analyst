# Copy to .env (or export) to configure. Nothing secret is committed.
LLM_PROVIDER=auto              # auto | ollama | openai | none
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# OpenAI-compatible endpoint (LM Studio, vLLM, hosted API)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_BACKEND=auto         # auto | sentence-transformers | tfidf
HYBRID_ALPHA=0.55
TOP_K=6
